{
    "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-non-abi-dispatch.schema.json",
    "context": {
        "$id": "Uniswap v4 PoolManager",
        "contract": {
            "deployments": [
                {
                    "chainId": 1,
                    "address": "0x000000000004444c5dc75cB358380D2e3dE08A90"
                }
            ]
        }
    },
    "metadata": {
        "owner": "Uniswap Labs",
        "contractName": "PoolManager",
        "info": {
            "url": "https://github.com/Uniswap/v4-core"
        }
    },
    "display": {
        "formats": {
            "initialize((address currency0,address currency1,uint24 fee,int24 tickSpacing,address hooks) key,uint160 sqrtPriceX96)": {
                "$id": "Initialize Pool",
                "intent": "Create pool",
                "fields": [
                    {
                        "path": "key.currency0",
                        "label": "Token 0",
                        "format": "addressName"
                    },
                    {
                        "path": "key.currency1",
                        "label": "Token 1",
                        "format": "addressName"
                    },
                    {
                        "path": "key.fee",
                        "label": "Fee",
                        "switch": {
                            "expression": {
                                "path": "key.fee"
                            },
                            "cases": {
                                "0x800000": {
                                    "label": "Dynamic, set by the hooks contract"
                                },
                                "$default": {
                                    "format": "unit",
                                    "params": {
                                        "base": "%",
                                        "decimals": 4
                                    }
                                }
                            }
                        }
                    },
                    {
                        "path": "key.tickSpacing",
                        "label": "Tick spacing",
                        "format": "raw"
                    },
                    {
                        "path": "key.hooks",
                        "label": "Hooks contract",
                        "format": "addressName"
                    },
                    {
                        "path": "key.hooks",
                        "customEncoding": {
                            "type": "bitfield",
                            "bytes": 20,
                            "bitranges": [
                                {
                                    "name": "beforeInitialize",
                                    "bit": 13,
                                    "label": "Hook before initialize",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "afterInitialize",
                                    "bit": 12,
                                    "label": "Hook after initialize",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "beforeAddLiquidity",
                                    "bit": 11,
                                    "label": "Hook before add liquidity",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "afterAddLiquidity",
                                    "bit": 10,
                                    "label": "Hook after add liquidity",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "beforeRemoveLiquidity",
                                    "bit": 9,
                                    "label": "Hook before remove liquidity",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "afterRemoveLiquidity",
                                    "bit": 8,
                                    "label": "Hook after remove liquidity",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "beforeSwap",
                                    "bit": 7,
                                    "label": "Hook before swap",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "afterSwap",
                                    "bit": 6,
                                    "label": "Hook after swap",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "beforeDonate",
                                    "bit": 5,
                                    "label": "Hook before donate",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "afterDonate",
                                    "bit": 4,
                                    "label": "Hook after donate",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "beforeSwapReturnDelta",
                                    "bit": 3
                                },
                                {
                                    "name": "afterSwapReturnDelta",
                                    "bit": 2,
                                    "label": "Hook after swap returning a delta",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "afterAddLiquidityReturnDelta",
                                    "bit": 1,
                                    "label": "Hook after add liquidity returning a delta",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                },
                                {
                                    "name": "afterRemoveLiquidityReturnDelta",
                                    "bit": 0,
                                    "label": "Hook after remove liquidity returning a delta",
                                    "format": "raw",
                                    "visible": {
                                        "ifNotIn": [
                                            false
                                        ]
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "path": "key.hooks.beforeSwapReturnDelta",
                        "label": "Hook before swap returning a delta",
                        "format": "raw",
                        "visible": {
                            "ifNotIn": [
                                false
                            ]
                        }
                    },
                    {
                        "path": "sqrtPriceX96",
                        "label": "Initial price (sqrtPriceX96)",
                        "format": "raw"
                    }
                ]
            }
        }
    }
}
