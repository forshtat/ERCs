{
    "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-non-abi-dispatch.schema.json",
    "context": {
        "$id": "Stargate V2 USDC Pool",
        "contract": {
            "deployments": [
                {
                    "chainId": 1,
                    "address": "0xc026395860Db2d07ee33e05fE50ed7bD583189C7"
                }
            ]
        }
    },
    "metadata": {
        "owner": "Stargate",
        "contractName": "StargatePoolUSDC",
        "info": {
            "url": "https://github.com/stargate-protocol/stargate-v2"
        },
        "enums": {
            "endpointId": {
                "30101": "Ethereum",
                "30109": "Polygon",
                "30110": "Arbitrum",
                "30111": "Optimism",
                "30168": "Solana",
                "30184": "Base"
            }
        }
    },
    "display": {
        "formats": {
            "send((uint32 dstEid,bytes32 to,uint256 amountLD,uint256 minAmountLD,bytes extraOptions,bytes composeMsg,bytes oftCmd) sendParam,(uint256 nativeFee,uint256 lzTokenFee) fee,address refundAddress)": {
                "$id": "Stargate Send",
                "intent": "Bridge USDC",
                "fields": [
                    {
                        "path": "sendParam.amountLD",
                        "label": "Amount",
                        "format": "tokenAmount",
                        "params": { "token": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48" }
                    },
                    {
                        "path": "sendParam.minAmountLD",
                        "label": "Minimum received",
                        "format": "tokenAmount",
                        "params": { "token": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48" }
                    },
                    {
                        "path": "sendParam.dstEid",
                        "label": "Destination",
                        "format": "enum",
                        "params": { "$ref": "$.metadata.enums.endpointId" }
                    },
                    {
                        "path": "sendParam.to",
                        "label": "Recipient (destination chain)",
                        "format": "raw"
                    },
                    {
                        "path": "sendParam.oftCmd",
                        "label": "Delivery",
                        "switch": {
                            "expression": { "lengthOf": "sendParam.oftCmd" },
                            "cases": {
                                "0": { "label": "Immediate (taxi)" },
                                "$default": { "label": "Batched (bus)" }
                            }
                        }
                    },
                    {
                        "path": "sendParam.composeMsg",
                        "label": "Destination call",
                        "switch": {
                            "expression": { "lengthOf": "sendParam.composeMsg" },
                            "cases": {
                                "0": { "label": "None" },
                                "$default": { "label": "Calls a contract on the destination chain", "intent": "warning" }
                            }
                        }
                    },
                    {
                        "path": "fee.nativeFee",
                        "label": "Messaging fee",
                        "format": "amount"
                    },
                    {
                        "path": "refundAddress",
                        "label": "Fee refund to",
                        "format": "addressName"
                    }
                ]
            }
        }
    }
}
