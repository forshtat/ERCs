{
    "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-non-abi-dispatch.schema.json",
    "context": {
        "$id": "Zodiac Roles v2",
        "contract": {
            "factory": {
                "deployEvent": "event ModuleProxyCreation(address indexed proxy, address indexed masterCopy)",
                "deployments": [
                    {
                        "chainId": 1,
                        "address": "0x000000000000aDdB49795b0f9bA5BC298cDda236"
                    }
                ]
            }
        }
    },
    "metadata": {
        "owner": "Zodiac Labs",
        "contractName": "Roles",
        "info": {
            "url": "https://zodiac.eco"
        }
    },
    "display": {
        "formats": {
            "scopeTarget(bytes32 roleKey,address targetAddress)": {
                "$id": "Scope Target",
                "intent": "Scope target",
                "interpolatedIntent": "Scope {targetAddress} for role {roleKey}",
                "fields": [
                    {
                        "path": "roleKey",
                        "label": "Role",
                        "customEncoding": {
                            "type": "string",
                            "length": 32
                        }
                    },
                    {
                        "path": "targetAddress",
                        "label": "Target",
                        "format": "addressName"
                    }
                ]
            }
        }
    }
}
